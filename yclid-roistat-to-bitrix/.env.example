HOST=127.0.0.1
PORT=8080
WEBHOOK_SECRET=change-me

# Inbound Bitrix24 REST webhook URL with CRM permissions.
# Example: https://example.bitrix24.ru/rest/1/xxxxxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=

# Custom Bitrix24 deal field where the Yandex Metrika Client ID should be saved.
# Example: UF_CRM_1700000000000
BITRIX_METRIKA_FIELD=

# Optional: custom Bitrix24 deal field containing Roistat visit ID.
# If empty, the script tries to resolve the client by phone through Roistat.
BITRIX_ROISTAT_VISIT_FIELD=

# Optional: process only deals whose source/origin contains this text.
# Example: megafon
MEGAFON_MATCH=megafon

ROISTAT_PROJECT_ID=
ROISTAT_API_KEY=

# How many days back to look for Roistat visits if we resolve by phone.
ROISTAT_LOOKBACK_DAYS=30
